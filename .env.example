# Port number
PORT=4000

# Postgres URL
DATABASE_URL="postgresql://mv_service:mv_service_dev@localhost:5433/mv_service_db"
# Required for db seed admin user
ADMIN_PASSWORD="admin"
# JWT
# JWT secret key
JWT_SECRET=thisisasamplesecret
# Number of minutes after which an access token expires
JWT_ACCESS_EXPIRATION_MINUTES=30
# Number of days after which a refresh token expires
JWT_REFRESH_EXPIRATION_DAYS=30
# Number of minutes after which a reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
# Number of minutes after which a verify email token expires
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# SMTP configuration options for the email service
# For testing, you can use a fake SMTP service like Ethereal: https://ethereal.email/create

CLIENT_BASE_URL=http://localhost:3000
APP_NAME=MyApp

# Google Sign-In (OAuth client ID de tip "Web application" din Google Cloud Console).
# Lipsa lui dezactiveaza POST /v1/auth/google (raspunde 501).
GOOGLE_CLIENT_ID=

# --- Cookies (refresh token) + CORS ---
# Origini permise, separate prin virgula. Obligatoriu in productie.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# "lax"  -> frontend si API pe acelasi domeniu (shop.ro + api.shop.ro)
# "none" -> domenii complet diferite; impune COOKIE_SECURE=true si e
#           blocat ca third-party de Safari/Firefox
COOKIE_SAME_SITE=lax
# implicit: true in productie, false altfel
COOKIE_SECURE=false
# ex: .shop.ro ca sa acopere si subdomeniile. Gol in development.
COOKIE_DOMAIN=

# --- Email ---
# "disabled" = nu trimite nimic | "smtp" = Mailpit local (docker compose)
EMAIL_DRIVER=smtp
EMAIL_FROM=no-reply@mv-service.local
# Mailpit: SMTP pe 1025, UI web pe http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
