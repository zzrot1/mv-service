{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "silently-remove-extras",
  "controllerPathGlobs": ["src/api/controllers/**/*.ts"],
  "spec": {
    "specVersion": 3,
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "outputDirectory": "src/api",
    "basePath": "/v1"
  },
  "routes": {
    "routesDir": "src/api/generated",
    "middleware": "express",
    "esm": true,
    "iocModule": "src/config/ioc.ts",
    "authenticationModule": "src/config/tsoaAuthentication.ts"
  }
}
