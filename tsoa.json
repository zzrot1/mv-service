{
  "entryFile": "src/server.ts",
  "noImplicitAdditionalProperties": "silently-remove-extras",
  "controllerPathGlobs": ["src/controllers/**/*.ts"],
  "spec": {
    "specVersion": 3,
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "outputDirectory": "dist",
    "basePath": "/v1"
  },
  "routes": {
    "routesDir": "dist",
    "middleware": "express",
    "esm": true
  }
}
